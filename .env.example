# Strava API Configuration (primary activity data source)
# Get these values from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_ACCESS_TOKEN=your_access_token_here
STRAVA_REFRESH_TOKEN=your_refresh_token_here

# Telegram Bot Configuration
BOT_API_TOKEN=your_telegram_bot_token_here

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# File Storage
GPX_STORAGE_PATH=./data/gpx

# GPX Cleanup Configuration
GPX_CLEANUP_ENABLED=true
GPX_CLEANUP_SCHEDULE_HOUR=3
GPX_CLEANUP_SCHEDULE_MINUTE=0

# Local activity backup/synchronization database
DATABASE_URL=sqlite:///./strava_noshoes.db
MIGRATION_CUTOFF=2026-10-15
STRAVA_BACKUP_ENABLED=true
STRAVA_BACKUP_ON_STARTUP=true
STRAVA_BACKUP_SCHEDULE_HOUR=4
STRAVA_BACKUP_SCHEDULE_MINUTE=15
STRAVA_BACKUP_STREAMS_PER_RUN=60

# Garmin becomes the activity source on the day after MIGRATION_CUTOFF.
GARMIN_EMAIL=your_garmin_email_here
GARMIN_PASSWORD=your_garmin_password_here
GARMIN_TOKEN_STORE=./data/garmin_tokens
GARMIN_SYNC_ENABLED=true
GARMIN_SYNC_LOOKBACK_DAYS=7
