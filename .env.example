# Strava API Configuration (primary activity data source)
# Get these values from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_ACCESS_TOKEN=your_access_token_here
STRAVA_REFRESH_TOKEN=your_refresh_token_here

# Telegram Bot Configuration
BOT_API_TOKEN=your_telegram_bot_token_here
BOT_TIMEZONE=Europe/Moscow
BOT_ENABLED=true
# Set both IDs to enable one shared bot; zero keeps the legacy single account mode.
BOT_PRIMARY_USER_ID=0
BOT_SECONDARY_USER_ID=0
BOT_SECONDARY_API_URL=http://strava-noshoes-secondary:8000

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# File Storage
GPX_STORAGE_PATH=./data/gpx

# GPX Cleanup Configuration
GPX_CLEANUP_ENABLED=true
GPX_CLEANUP_SCHEDULE_HOUR=3
GPX_CLEANUP_SCHEDULE_MINUTE=0

# Local activity backup/synchronization database
DATABASE_URL=sqlite:///./strava_noshoes.db
MIGRATION_ENABLED=true
MIGRATION_CUTOFF=2026-10-15
STRAVA_BACKUP_ENABLED=true
# Starts the active source sync on startup, including Garmin after cutover.
STRAVA_BACKUP_ON_STARTUP=true
STRAVA_BACKUP_SCHEDULE_HOUR=4
STRAVA_BACKUP_SCHEDULE_MINUTE=15
STRAVA_BACKUP_STREAMS_PER_RUN=60

# Garmin becomes the activity source on the day after MIGRATION_CUTOFF.
GARMIN_EMAIL=your_garmin_email_here
GARMIN_PASSWORD=your_garmin_password_here
GARMIN_TOKEN_STORE=./data/garmin_tokens
GARMIN_SYNC_ENABLED=true
GARMIN_SYNC_LOOKBACK_DAYS=7

# Daily wellness data is stored independently of activity synchronization.
# Runs on startup and every 6 hours on the Garmin instance only.
GARMIN_HEALTH_SYNC_ENABLED=true
GARMIN_HEALTH_SYNC_INTERVAL_HOURS=6
GARMIN_HEALTH_TIMEZONE=Europe/Moscow
GARMIN_HEALTH_HISTORY_DAYS=90
GARMIN_HEALTH_LOOKBACK_DAYS=7
# Historical days per metric per run, in addition to the recent lookback.
GARMIN_HEALTH_BACKFILL_DAYS_PER_RUN=7
GARMIN_HEALTH_REQUEST_DELAY_SECONDS=0.5
# Optional fixed first date for a deeper historical import (YYYY-MM-DD).
GARMIN_HEALTH_START_DATE=
